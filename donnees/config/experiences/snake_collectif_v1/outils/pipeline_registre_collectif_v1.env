# Exemple de config pour pipeline_registre_collectif_v1.sh
# Format: KEY=VALUE (pas d\x27espaces autour du =)

# Liste des prefix-bits testés par o1 (surprises)
SNAKE_O1_PREFIX_BITS="12 16 20"

# 1 = rendre o1 obligatoire (échoue si metrics.jsonl absent)
SNAKE_O1_REQUIRE_METRICS=0

# (optionnel) forcer le run-dir (sinon le pipeline choisit automatiquement)
# SNAKE_RUN_DIR="donnees/config/experiences/snake_collectif_v1/artefacts/runs/<run>"

# (optionnel) Filtrage des runs (sur le nom du dossier run)
# Exemple : traiter seulement C1/C2, et ignorer les runs de test manuels.
#   SNAKE_RUN_INCLUDE_REGEX="__C1__|__C2__"
#   SNAKE_RUN_EXCLUDE_REGEX="_tui$|_manual$"
#   SNAKE_RUN_MAX="20"

# Laisser vide = pas de filtre
SNAKE_RUN_INCLUDE_REGEX=""
SNAKE_RUN_EXCLUDE_REGEX=""
SNAKE_RUN_MAX=""
